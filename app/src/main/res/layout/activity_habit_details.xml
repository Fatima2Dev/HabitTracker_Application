<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F383D"
    tools:context=".Habit_Details">

    <RelativeLayout
        android:id="@+id/HabitDetailsToolbar"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

    <ImageView
        android:id="@+id/backArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_back_42"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/back" />


        <TextView
            android:id="@+id/habit_name_tv"
            android:layout_width="343dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/backArrow"
            android:fontFamily="@font/Calm_Serif"
            android:text="Read 20 pages"
            android:textFontWeight="100"
            android:gravity="top|center_horizontal"
            android:textColor="@color/white"
            android:textSize="45sp"
            android:textStyle="bold" />

    </RelativeLayout>



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="52dp"
        android:paddingRight="30dp">
        <RelativeLayout
            android:id="@+id/DaysProgressMain"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:padding="16dp"
            android:layout_centerInParent="true"
            android:layout_alignParentLeft="true">
        <ProgressBar
        android:id="@+id/DaysProgress"
        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:indeterminate="false"
        android:layout_centerHorizontal="true"
        android:max="100"
        android:progress="75"
        app:indicatorColor="#2A7B7D"
        app:trackColor="#2A7B7D"
        app:trackThickness="12dp"

        />
            <LinearLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_centerInParent="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/DaysProgressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="45dp"
                    android:text="Successful Days:"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:textColor="@color/white"/>

                <TextView
                    android:id="@+id/DaysProgressValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:text="14"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:textColor="@color/white"/>


            </LinearLayout>

        </RelativeLayout>
        <FrameLayout
            android:layout_width="10dp"
            android:layout_height="100dp"
            android:layout_toRightOf="@id/DaysProgressMain"
            android:layout_toLeftOf="@id/WeeklyProgressMain"
            android:layout_centerVertical="true">
        <View
            android:id="@+id/divider2"
            android:layout_width="2dp"
            android:layout_height="100dp"
            android:background="@drawable/custom_divider"
            android:layout_gravity="center"
           >
        </FrameLayout>

    <RelativeLayout
        android:id="@+id/WeeklyProgressMain"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:padding="16dp"
        android:layout_centerInParent="true"
        android:layout_alignParentRight="true">

        <ProgressBar
        android:id="@+id/WeeklyProgress"
        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:indeterminate="false"
        android:max="100"
        app:indicatorColor="#2A7B7D"
        app:trackColor="#2A7B7D"
        app:trackThickness="12dp"
        android:progress="75"
            android:layout_centerHorizontal="true"
            />
        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_centerInParent="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/WeeklyProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="42dp"
                android:text="Weekly Success Rate:"
                android:textSize="11sp"
                android:gravity="center"
                android:textColor="@color/white"/>

            <TextView
                android:id="@+id/WeeklyProgressValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="80%"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="@color/white"/>


        </LinearLayout>


    </RelativeLayout>
    </RelativeLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="350dp"
        android:layout_height="2dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/custom_divider">

</LinearLayout>