<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    tools:context=".Habit_Details">

    <RelativeLayout
        android:id="@+id/HabitDetailsToolbar"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

    <ImageView
        android:id="@+id/backArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_back_42"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/back" />


        <TextView
            android:id="@+id/habit_name_tv"
            android:layout_width="343dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/backArrow"
            android:fontFamily="@font/calm_serif"
            android:text="Read 20 pages"
            android:textFontWeight="100"
            android:gravity="top|center_horizontal"
            android:textColor="@color/white"
            android:textSize="45sp"
            android:textStyle="bold" />

    </RelativeLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="52dp"
            android:paddingRight="30dp">

            <RelativeLayout
                android:id="@+id/DaysProgressMain"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:padding="16dp">

                <ProgressBar
                    android:id="@+id/DaysProgress"
                    style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_centerHorizontal="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="75"
                    app:indicatorColor="#2A7B7D"
                    app:trackColor="#2A7B7D"
                    app:trackThickness="12dp"

                    />

                <LinearLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_centerInParent="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/DaysProgressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="45dp"
                        android:text="Successful Days:"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/DaysProgressValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="2dp"
                        android:text="14"
                        android:textColor="@color/white"
                        android:textSize="14sp" />


                </LinearLayout>

            </RelativeLayout>

            <FrameLayout
                android:layout_width="10dp"
                android:layout_height="100dp"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@id/WeeklyProgressMain"
                android:layout_toRightOf="@id/DaysProgressMain">

                <View
                    android:id="@+id/divider_horizontal"
                    android:layout_width="2dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@drawable/custom_divider">

                </View>
            </FrameLayout>

            <RelativeLayout
                android:id="@+id/WeeklyProgressMain"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_alignParentRight="true"
                android:layout_centerInParent="true"
                android:padding="16dp">

                <ProgressBar
                    android:id="@+id/WeeklyProgress"
                    style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_centerHorizontal="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="75"
                    app:indicatorColor="#2A7B7D"
                    app:trackColor="#2A7B7D"
                    app:trackThickness="12dp" />

                <LinearLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_centerInParent="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/WeeklyProgressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="42dp"
                        android:text="Weekly Success Rate:"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/WeeklyProgressValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="2dp"
                        android:text="80%"
                        android:textColor="@color/white"
                        android:textSize="14sp" />


                </LinearLayout>


            </RelativeLayout>
        </RelativeLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="350dp"
            android:layout_height="2dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/custom_divider">

        </View>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_light"
            android:paddingStart="35dp"
            android:paddingTop="8dp"
            android:text="Habit Loop"
            android:textColor="@color/white"
            android:textSize="25sp" />

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="35dp"
            android:paddingTop="10dp"
            android:paddingEnd="25dp">

            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="130dp"
                android:layout_marginRight="25dp">

                <View
                    android:layout_width="160dp"
                    android:layout_height="130dp"
                    android:background="@drawable/rounded_rectangle">

                </View>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:text="Cue (Time)"
                    android:textColor="#192C2C"
                    android:textSize="15sp"
                    android:textStyle="">

                </TextView>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >

                    <EditText
                        android:id="@+id/cue_et"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="false"
                        android:background="@android:color/transparent"
                        android:layout_marginEnd="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="3dp"
                        android:textSize="15sp"
                        android:text="After my morning coffee"
                        android:textColor="#039BB3"
                        android:textStyle="">

                    </EditText>

                </ScrollView>

                </LinearLayout>

            </FrameLayout>

            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="130dp">

                <View
                    android:layout_width="160dp"
                    android:layout_height="130dp"
                    android:background="@drawable/rounded_rectangle">

                </View>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"

                    android:text="Routine (Action)"
                    android:textColor="#0F383D"
                    >

                </TextView>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <EditText
                        android:id="@+id/routine_et"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="3dp"
                        android:textSize="15sp"
                        android:focusable="false"
                        android:clickable="false"
                        android:background="@android:color/transparent"
                        android:textColor="#039BB3"
                       >

                    </EditText>
                </ScrollView>
                </LinearLayout>
            </FrameLayout>


        </LinearLayout>

        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="130dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp">

            <View
                android:layout_width="160dp"
                android:layout_height="130dp"
                android:background="@drawable/rounded_rectangle"></View>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="Reward (Feeling)"
                android:textColor="#0F383D"
                android:textSize="15sp"
                >

            </TextView>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <EditText
                    android:id="@+id/reward_et"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="3dp"
                    android:textSize="15sp"
                    android:focusable="false"
                    android:clickable="false"
                    android:background="@android:color/transparent"
                    android:textColor="#039BB3"
                    >

                </EditText>
            </ScrollView>
            </LinearLayout>
        </FrameLayout>



        <View
            android:id="@+id/divider_horizontal2"
            android:layout_width="350dp"
            android:layout_height="2dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:background="@drawable/custom_divider">

        </View>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_light"
            android:paddingStart="35dp"
            android:paddingTop="8dp"
            android:text="Reflection"
            android:layout_marginBottom="20dp"
            android:textColor="@color/white"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/feeling_inquiry_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="13dp"
            android:paddingStart="21dp"
            android:visibility="gone"
            android:text="How did you feel today?"
            android:textColor="@color/white">

        </TextView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/feeling_selection_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:paddingStart="35dp"
            android:paddingBottom="35dp"
            android:visibility="gone"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/happy_face"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginRight="15dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/happy_face_30">

        </ImageView>
            <ImageView
                android:id="@+id/neutral_face"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginRight="15dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/neutral_face_30">

            </ImageView>

            <ImageView
                android:id="@+id/sad_face"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginRight="10dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/sad_face_30">

            </ImageView>


    </LinearLayout>

            <FrameLayout
                android:layout_width="325dp"
                android:layout_height="130dp"
                android:layout_marginStart="35dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_rectangle"
                    android:layout_marginBottom="20dp"
                    >

                </View>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:text="Notes"
                    android:textSize="15sp"
                    android:textColor="#0F383D"
                    >

                </TextView>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <EditText
                        android:id="@+id/reflection_et"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="3dp"
                        android:focusable="false"
                        android:clickable="false"
                        android:textSize="15sp"
                        android:background="@android:color/transparent"
                        android:textColor="#039BB3"
                        >

                    </EditText>
                </ScrollView>
                </LinearLayout>
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatButton

            android:layout_width="200dp"
                android:id="@+id/edit_habit_btn"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="25dp"
                android:layout_marginStart="20dp"
                android:textColor="#D8F8F1"
                android:background="@drawable/rectangular_button"
                android:backgroundTint="@null"
                android:text="@string/edit_habit">
        </androidx.appcompat.widget.AppCompatButton>

            <androidx.appcompat.widget.AppCompatButton

                android:layout_width="200dp"
                android:id="@+id/save_btn"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="25dp"
                android:layout_marginStart="20dp"
                android:visibility="gone"
                android:textColor="#F3F6F5"
                android:background="@drawable/save_button"
                android:backgroundTint="@null"
                android:text="@string/save_habit">
            </androidx.appcompat.widget.AppCompatButton>




        </LinearLayout>




</LinearLayout>

    </ScrollView>
</LinearLayout>